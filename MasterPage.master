<%@ Master Language="C#" AutoEventWireup="true" CodeFile="MasterPage.master.cs" EnableViewState="true" Inherits="MasterPage" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- chome mobile panel color -->
    <meta name="theme-color" content="#EDCE29">
    <!-- favicon -->
    <link rel="shortcut icon" href="img/ui/favicon.png" type="image/x-icon">

    <!-- bootstrap grid css -->
    <link rel="stylesheet" href="css/plugins/bootstrap-grid.css">
    <!-- swiper css -->
    <link rel="stylesheet" href="css/plugins/swiper.css">
    <!-- fancybox css -->
    <link rel="stylesheet" href="css/plugins/fancybox.css">
    <!-- font awesome css -->
    <link rel="stylesheet" href="css/plugins/fontawesome.css">
    <!-- main css -->
    <link rel="stylesheet" href="css/style.css">
    <!-- page title -->
    <title>3GB Technology</title>
    <style>
        @media (min-width: 320px) and (max-width: 991px) {
            .mil-footer-content ul {
                display: block !important;
            }
        }

        @media screen and (min-device-width: 992px) and (max-device-width: 5000px) {
            .mil-footer-content ul {
                justify-content: space-between !important;
                display: flex !important;
            }

            .neli {
                margin-bottom: 10px;
            }
        }
    </style>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <div>
            <div class="mil-page-wrapper">

                <!-- static content -->
                <div class="mil-preloader-frame">
                    <div class="mil-preloader-content">
                        <img src="img/ui/logo.png" alt="logo">
                        <div class="mil-preloader">
                            <div class="mil-preload-line"></div>
                        </div>
                        <div class="mil-fs-18 mil-pre-text mil-m-1 mil-fw-600">loading: <span class="mil-percent">00</span> %</div>
                    </div>
                </div>
                <div class="mil-top-panel">
                    <div class="container">
                        <div class="mil-tp-content">
                            <div class="mil-left">
                                <a href="Default.aspx" class="mil-logo mil-hover-bri-105" style="width: 38rem">
                                    <img src="img/ui/logo.png" alt="logo">
                                    <img src="img/ui/logo-light.png" alt="logo" class="mil-light">
                                </a>
                            </div>
                            <nav class="mil-main-menu">
                                <ul id="swupMenu" class="mil-menu-transition mil-aic mil-m-4">
                                    <li class="mil-current">
                                        <a href="Default.aspx">Home</a>

                                    </li>
                                    <li>
                                        <a href="about-us.aspx">About Us</a>
                                    </li>
                                    <li>
                                        <a href="track-your-order.aspx">Track Order</a>
                                    </li>
                                    <li>
                                        <a href="cancel-order.aspx">Cancel Order</a>
                                    </li>
                                    <li>
                                        <a href="contact.aspx">Contact</a>
                                    </li>
                                </ul>
                            </nav>
                            <div class="mil-right mil-jce">
                                <div class="mil-tp-phone mil-aic mil-mr-60 mil-sm-mr-15">
                                    <i class="far fa-mobile mil-icon mil-sm mil-bg-a-2 mil-m-4 mil-mr-15 mil-sm-hidden" style="padding-top: .2rem"></i>
                                    <a href="tel:+917073805777" class="mil-fw-600" data-no-swup="">7073805777</a>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>


                <!-- static content end -->
                <div id="swupMain" class="transition-fade">
                    <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                    </asp:ContentPlaceHolder>
                    <footer>
                        <div class="mil-footer-bg">
                            <video class="mil-footer-bg mil-scale-img" data-value-1="1" data-value-2="1.3" autoplay="autoplay" loop="loop" muted="" playsinline="" oncontextmenu="return false;" preload="auto">
                                <source src="img/ui/footer.mp4">
                            </video>
                        </div>
                        <div class="mil-footer-content">
                            <div class="container">
                                <div class="row mil-p-f-60">
                                    <div class="col-lg-12 col-md-12 col-sm-12 mil-mb-60">

                                        <ul class="d-flex justify-content-between">
                                            <li class="neli"><a href="faq.aspx">FAQ</a></li>

                                            <li class="neli"><a href="privacy-policy.aspx">Privacy Policy</a></li>
                                            <li class="neli"><a href="refund-cancellation-policy.aspx" target="_blank">Refund &amp; Cancellation Policy</a></li>
                                            <%-- <li class="neli"><a href="safe-secure-transaction.aspx">Safe &amp; Secure Transaction</a></li>--%>
                                            <li class="neli"><a href="terms-conditions.aspx">Terms &amp; Conditions</a></li>

                                            <li class="neli"><a href="government-notifications.aspx">Government Notifications</a></li>
                                            <%-- <li class="neli"><a href="about-hsrp.aspx" target="_blank">About HSRP</a></li>--%>

                                            <%--  <li class="neli"><a href="grievance-redressal.aspx">Grievance Redressal</a></li>--%>
                                            <%--<li class="neli"><a href="reprint-receipt.aspx">Reprint Receipt</a></li>--%>
                                        </ul>
                                    </div>
                                </div>
                                <div class="mil-dots "></div>
                                <div class="mil-footer-bottom mil-aic mil-jcb ">
                                    <p>
                                        © Copyright
                                        <script>document.write(new Date().getFullYear());</script>
                                        - All Rights Reserved.
                                    </p>
                                    
                                </div>
                            </div>
                        </div>
                    </footer>
                    <!-- footer end -->

                </div>
            </div>
        </div>
    </form>
    <script src="js/plugins/swup.min.js"></script>
    <!-- swup body class plugin -->
    <script src="js/plugins/SwupBodyClassPlugin.min.js"></script>
    <!-- gsap js -->
    <script src="js/plugins/gsap.js"></script>
    <!-- scroll trigger js -->
    <script src="js/plugins/scroll-trigger.js"></script>
    <!-- lenis js -->
    <script src="js/plugins/lenis.js"></script>

    <!-- swiper js -->
    <script src="js/plugins/swiper.min.js"></script>
    <!-- fancybox js -->
    <script src="js/plugins/fancybox.js"></script>

    <!-- main js -->
    <script src="js/main.js"></script>
</body>
</html>
